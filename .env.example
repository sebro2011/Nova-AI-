# Nova AI — environment configuration (placeholders only).
# Copy this file to ".env.local" and fill in real values.
# NEVER commit ".env.local" or real API tokens.

# Hugging Face access token (server-side only, never exposed to the browser).
# Create one at https://huggingface.co/settings/tokens
HF_TOKEN=

# Default model id (required for the chat API to work).
# Example: Qwen/Qwen2.5-72B-Instruct
HF_MODEL=

# Optional: comma-separated allowlist of additional model ids shown in the
# model picker when more than one is configured.
# HF_MODELS=Qwen/Qwen2.5-72B-Instruct,mistralai/Mistral-7B-Instruct-v0.3

# Optional: Inference provider. "auto" routes to the first available provider
# for the model (per your huggingface.co Inference Providers settings).
# See @huggingface/inference for the supported provider names.
# HF_PROVIDER=auto

# Optional tuning (defaults shown):
# MAX_OUTPUT_TOKENS=1024
# PROVIDER_TIMEOUT_MS=60000
# RATE_LIMIT_MAX=20
# RATE_LIMIT_WINDOW_MS=60000
